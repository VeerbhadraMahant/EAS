# Copy to .env and fill in. Local dev only needs DATABASE_URL (default below
# matches docker-compose.yml as-is). Everything else is needed later, not for
# the schema/skeleton step — see SETUP.md for which is which.

ENV=local

# Matches docker-compose.yml's postgres service. Change only if you changed
# that file too.
DATABASE_URL=postgresql+psycopg://eas:eas@localhost:5432/eas

# Cloudflare R2 (paper bundles, crops, generated PDFs). Not needed until the
# ingestion/bundle-build step.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Comma-separated origins allowed to call the API. The Vite dev server default.
CORS_ORIGINS=http://localhost:5173
